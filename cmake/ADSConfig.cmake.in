# --------------------------------------------------------------------------- #
#    Package configuration file                                               #
#                                                                             #
#    This file contains instructions on how to generate ADSConfig.cmake,      #
#    that is, the file that tells CMake how the package should be             #
#    configured when found by other projects using find_package(ADS): it      #
#    defines ADS::ADS, ADS::ADS_module and the modules of the sets            #
#    ADS::ADS_module_core, ADS::ADS_module_base and ADS::ADS_module_advanced  #
#    when ADS was built with ADS_BUILD_MODULE, and ADS::GMP, ADS::BLAS,       #
#    ADS::Boost and ADS::Highway when it was built on GMP, on a CBLAS, on     #
#    Boost and on Highway, which are then the components GMP, BLAS, Boost     #
#    and Highway of find_package(ADS COMPONENTS ...), and it finds again the  #
#    threads, OpenMP, oneTBB and MPI when ADS                                 #
#    was built with their executors; the component LEMON, ADS::LEMON, when    #
#    ADS was built with it and LEMON is found again (find_package(ADS         #
#    COMPONENTS LEMON) requires it), and the runtimes of the components       #
#    ADS::StdPar, ADS::stdexec, ADS::Taskflow, ADS::Kokkos and ADS::BoostMPI  #
#    [see ADSInterop.cmake].                                                  #
#                                                                             #
#    ADSTargets.cmake (to be found alongside this file) is the target import  #
#    file that tells where the headers are.                                   #
# --------------------------------------------------------------------------- #
@PACKAGE_INIT@

get_filename_component(ADS_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

# ----- Requirements -------------------------------------------------------- #
# ADS built on GMP and on a CBLAS links them, and on Boost includes its
# headers, found again here, first where they were found when ADS was built
set(ADS_WITH_GMP @ADS_USE_GMP@)
if (ADS_WITH_GMP)
    set(ADS_GMP_HINTS "@ADS_GMP_HINTS@")
    include("${ADS_CMAKE_DIR}/ADSGMP.cmake")
    if (NOT ADS_GMP_FOUND)
        set(ADS_FOUND FALSE)
        set(ADS_NOT_FOUND_MESSAGE "ADS was built with GMP, not found")
        return()
    endif ()
endif ()
set(ADS_WITH_BLAS @ADS_USE_BLAS@)
if (ADS_WITH_BLAS)
    set(ADS_BLAS_HINTS "@ADS_BLAS_HINTS@")
    include("${ADS_CMAKE_DIR}/ADSBLAS.cmake")
    if (NOT ADS_BLAS_FOUND)
        set(ADS_FOUND FALSE)
        set(ADS_NOT_FOUND_MESSAGE "ADS was built with a CBLAS, not found")
        return()
    endif ()
endif ()
set(ADS_WITH_HWLOC @ADS_USE_HWLOC@)
if (ADS_WITH_HWLOC)
    set(ADS_HWLOC_HINTS "@ADS_HWLOC_HINTS@")
    include("${ADS_CMAKE_DIR}/ADSHwloc.cmake")
    if (NOT ADS_HWLOC_FOUND)
        set(ADS_FOUND FALSE)
        set(ADS_NOT_FOUND_MESSAGE "ADS was built with hwloc, not found")
        return()
    endif ()
endif ()

# the pool of threads, and the executors ADS was built with
find_dependency(Threads)
if (@ADS_WITH_OPENMP@)
    find_dependency(OpenMP)
endif ()
if (@ADS_WITH_TBB@)
    find_dependency(TBB)
endif ()
if (@ADS_USE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif ()

set(ADS_WITH_BOOST @ADS_USE_BOOST@)
if (ADS_WITH_BOOST)
    set(ADS_BOOST_HINTS "@ADS_BOOST_HINTS@")
    include("${ADS_CMAKE_DIR}/ADSBoost.cmake")
    if (NOT ADS_BOOST_FOUND)
        set(ADS_FOUND FALSE)
        set(ADS_NOT_FOUND_MESSAGE "ADS was built with Boost, not found")
        return()
    endif ()
endif ()

set(ADS_WITH_HIGHWAY @ADS_USE_HIGHWAY@)
if (ADS_WITH_HIGHWAY)
    set(ADS_HWY_HINTS "@ADS_HWY_HINTS@")
    include("${ADS_CMAKE_DIR}/ADSHighway.cmake")
    if (NOT ADS_HWY_FOUND)
        set(ADS_FOUND FALSE)
        set(ADS_NOT_FOUND_MESSAGE "ADS was built with Highway, not found")
        return()
    endif ()
endif ()

# ----- Import target ------------------------------------------------------- #
if (NOT TARGET ADS::ADS)
    include("${ADS_CMAKE_DIR}/ADSTargets.cmake")
endif ()

# the component LEMON, if ADS was built with it and LEMON is found again
set(ADS_LEMON_FOUND FALSE)
if (@ADS_USE_LEMON@)
    set(ADS_LEMON_HINTS "@ADS_LEMON_HINTS@")
    include("${ADS_CMAKE_DIR}/ADSLemon.cmake")
    if (ADS_LEMON_FOUND AND NOT TARGET ADS::LEMON)
        include("${ADS_CMAKE_DIR}/ADSLemonTargets.cmake")
        # the warm start, written from the LEMON found here, first on the
        # include path
        include("${ADS_CMAKE_DIR}/ADSLemonShim.cmake")
        set(ADS_LEMON_SHIM_DIR ${CMAKE_BINARY_DIR}/ads-lemon-shim)
        set(_ads_src "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
        ads_lemon_shim(${ADS_LEMON_SHIM_DIR} ${LEMON_INCLUDE_DIR}
                       "${_ads_src}/ADS/interop/lemon/shim"
                       ADS_LEMON_SHIM_FOUND)
        unset(_ads_src)
        if (ADS_LEMON_SHIM_FOUND)
            get_target_property(_ads_inc ADS::LEMON
                                INTERFACE_INCLUDE_DIRECTORIES)
            if (NOT _ads_inc)
                set(_ads_inc "")
            endif ()
            set_target_properties(ADS::LEMON PROPERTIES
                    INTERFACE_INCLUDE_DIRECTORIES
                    "${ADS_LEMON_SHIM_DIR};${_ads_inc}")
            set_property(TARGET ADS::LEMON APPEND PROPERTY
                         INTERFACE_COMPILE_DEFINITIONS ADS_LEMON_SHIM)
            unset(_ads_inc)
        endif ()
    endif ()
endif ()

# ----- Components ---------------------------------------------------------- #
# the runtimes of a program that ADS was built with, each the component and
# the target ADS::<name> [see ADSInterop.cmake]: those asked by
# find_package(ADS COMPONENTS ...), or all of them if none is asked, found
# again here, first where they were found when ADS was built; a component
# not found is not there, an error only if it was asked as required
set(ADS_INTEROP_BUILT "@ADS_INTEROP_BUILT@")
set(ADS_INTEROP_WANT "")
foreach (c IN LISTS ADS_INTEROP_BUILT)
    if (NOT ADS_FIND_COMPONENTS OR c IN_LIST ADS_FIND_COMPONENTS)
        list(APPEND ADS_INTEROP_WANT ${c})
    endif ()
endforeach ()
if (ADS_INTEROP_WANT)
    if (NOT STDEXEC_INCLUDE_DIR)
        set(STDEXEC_INCLUDE_DIR "@STDEXEC_INCLUDE_DIR@")
    endif ()
    if (NOT Taskflow_INCLUDE_DIR)
        set(Taskflow_INCLUDE_DIR "@Taskflow_INCLUDE_DIR@")
    endif ()
    if (NOT Kokkos_DIR)
        set(Kokkos_DIR "@Kokkos_DIR@")
    endif ()
    if (NOT cereal_INCLUDE_DIR)
        set(cereal_INCLUDE_DIR "@cereal_INCLUDE_DIR@")
    endif ()
    if (NOT EIGEN3_INCLUDE_DIR)
        set(EIGEN3_INCLUDE_DIR "@EIGEN3_INCLUDE_DIR@")
    endif ()
    if (NOT METIS_INCLUDE_DIR)
        set(METIS_INCLUDE_DIR "@METIS_INCLUDE_DIR@")
    endif ()
    if (NOT METIS_LIBRARY)
        set(METIS_LIBRARY "@METIS_LIBRARY@")
    endif ()
    if (NOT KaHIP_INCLUDE_DIR)
        set(KaHIP_INCLUDE_DIR "@KaHIP_INCLUDE_DIR@")
    endif ()
    if (NOT KaHIP_LIBRARY)
        set(KaHIP_LIBRARY "@KaHIP_LIBRARY@")
    endif ()
    if (NOT GraphBLAS_INCLUDE_DIR)
        set(GraphBLAS_INCLUDE_DIR "@GraphBLAS_INCLUDE_DIR@")
    endif ()
    if (NOT GraphBLAS_LIBRARY)
        set(GraphBLAS_LIBRARY "@GraphBLAS_LIBRARY@")
    endif ()
    if (NOT NetworKit_INCLUDE_DIR)
        set(NetworKit_INCLUDE_DIR "@NetworKit_INCLUDE_DIR@")
    endif ()
    if (NOT NetworKit_LIBRARY)
        set(NetworKit_LIBRARY "@NetworKit_LIBRARY@")
    endif ()
    if (NOT tlx_INCLUDE_DIR)
        set(tlx_INCLUDE_DIR "@tlx_INCLUDE_DIR@")
    endif ()
    if (NOT roaring_DIR)
        set(roaring_DIR "@roaring_DIR@")
    endif ()
    if (NOT CRoaring_INCLUDE_DIR)
        set(CRoaring_INCLUDE_DIR "@CRoaring_INCLUDE_DIR@")
    endif ()
    if (NOT CRoaring_LIBRARY)
        set(CRoaring_LIBRARY "@CRoaring_LIBRARY@")
    endif ()
    if (NOT sdsl_INCLUDE_DIR)
        set(sdsl_INCLUDE_DIR "@sdsl_INCLUDE_DIR@")
    endif ()
    include("${ADS_CMAKE_DIR}/ADSInterop.cmake")
endif ()

set(ADS_LIBRARIES ADS::ADS)

# the components, found when ADS was built on them: find_package(ADS
# COMPONENTS Boost) for the delegations to Boost and the headers of
# ADS/interop/boost/, GMP, BLAS and Highway for the other backends
set(ADS_Boost_FOUND ${ADS_WITH_BOOST})
set(ADS_GMP_FOUND ${ADS_WITH_GMP})
set(ADS_BLAS_FOUND ${ADS_WITH_BLAS})
set(ADS_Highway_FOUND ${ADS_WITH_HIGHWAY})

check_required_components(ADS)

# --------------------------------------------------------------------------- #
