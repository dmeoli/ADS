###############################################################################
#                            ADSConfig.cmake.in                               #
#                                                                             #
# The configuration that find_package(ADS) reads: it defines ADS::ADS,        #
# ADS::ADS_module when ADS was built with ADS_BUILD_MODULE and ADS::GMP when  #
# it was built with ADS_WITH_GMP; it finds again the threads, OpenMP and      #
# oneTBB when ADS was built with their executors, and MPI.                    #
###############################################################################

@PACKAGE_INIT@

# ADS built with ADS_WITH_GMP links GMP, found again here
set(ADS_WITH_GMP @ADS_WITH_GMP@)
if (ADS_WITH_GMP)
    include("${CMAKE_CURRENT_LIST_DIR}/ADSGMP.cmake")
    if (NOT ADS_GMP_FOUND)
        set(ADS_FOUND FALSE)
        set(ADS_NOT_FOUND_MESSAGE "ADS was built with GMP, not found")
        return()
    endif ()
endif ()

# the pool of threads, and the executors ADS was built with
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if (@ADS_WITH_OPENMP@)
    find_dependency(OpenMP)
endif ()
if (@ADS_WITH_TBB@)
    find_dependency(TBB)
endif ()
if (@ADS_WITH_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/ADSTargets.cmake")
check_required_components(ADS)
