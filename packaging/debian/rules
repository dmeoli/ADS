#!/usr/bin/make -f

# the tests of the book are built and run unless nocheck is asked
ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
ADS_TESTS = OFF
else
ADS_TESTS = ON
endif

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DADS_BUILD_TESTS=$(ADS_TESTS) \
	                     -DBUILD_TESTING=$(ADS_TESTS) \
	                     -DADS_WITH_GMP=OFF -DADS_WITH_BLAS=OFF \
	                     -DADS_WITH_BOOST=OFF -DADS_WITH_HIGHWAY=OFF \
	                     -DADS_WITH_LEMON=OFF \
	                     -DADS_WITH_MPI=OFF \
	                     -DADS_WITH_STDPAR=OFF -DADS_WITH_STDEXEC=OFF \
	                     -DADS_WITH_TASKFLOW=OFF -DADS_WITH_KOKKOS=OFF \
	                     -DADS_WITH_BOOST_MPI=OFF -DADS_WITH_HWLOC=OFF \
	                     -DADS_WITH_CEREAL=OFF -DADS_WITH_EIGEN=OFF \
	                     -DADS_WITH_METIS=OFF -DADS_WITH_KAHIP=OFF \
	                     -DADS_WITH_GRAPHBLAS=OFF -DADS_WITH_NETWORKIT=OFF \
	                     -DADS_WITH_CROARING=OFF -DADS_WITH_SDSL=OFF
