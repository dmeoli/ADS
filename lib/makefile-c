###############################################################################
################################# makefile-c ##################################
###############################################################################
#                                                                             #
#   complete makefile of ADS                                                  #
#                                                                             #
#   The makefile defines internally all the external libraries of the         #
#   optional backends of ADS, each turned on by its macro, and adds the       #
#   necessary -I, -D and compiler options to $(ADSINC) and the external       #
#   libraries + -L< libdirs > to $(ADSLIB), with -pthread for the pool of     #
#   threads of ADS. The makefiles dealing with the external libraries are     #
#   in the extlib/ folder of ADS, i.e., in $(ADSSDR)/extlib/, together with   #
#   the paths where the libraries are to be found.                            #
#                                                                             #
#   Input:  $(CXX)               = compiler command                           #
#           $(CXXFLAGS)          = compiler options                           #
#           $(ADSSDR)            = the directory where the ADS source is      #
#           $(ADSODR)            = the directory where the objects have to    #
#                                  be put                                     #
#           $(ADS_WITH_GMP)      = 1 for BigInteger and Rational on GMP [see  #
#                                  BigInteger.h and Rational.h], 0 for their  #
#                                  own code, auto (the default) for GMP when  #
#                                  a program that calls it compiles and links #
#           $(ADS_WITH_BLAS)     = the same for gemm() on a CBLAS [see        #
#                                  DenseMatrix.h]                             #
#           $(ADS_WITH_OPENMP)   = 1 for the executor of OpenMP [see          #
#                                  OpenMPExecutor.h]                          #
#           $(ADS_WITH_TBB)      = 1 for the executor of oneTBB [see          #
#                                  TBBExecutor.h]                             #
#           $(ADS_WITH_FASTFLOW) = 1 for the executor of FastFlow [see        #
#                                  FastFlowExecutor.h]                        #
#           $(ADS_WITH_MPI)      = the same as $(ADS_WITH_GMP) for the sort   #
#                                  and the runtime over the processes of MPI  #
#                                  [see include/ADS/distributed], the         #
#                                  options of MPI asked to $(MPICXX)          #
#           $(GMP_ROOT), $(BLAS_ROOT), $(OpenMP_ROOT), $(TBB_ROOT),           #
#           $(FastFlow_ROOT),                                                 #
#           $(MPI_ROOT)          = where the libraries are, see               #
#                                  extlib/makefile-paths (GMP=<prefix> and    #
#                                  BLAS=<prefix> on the command line are the  #
#                                  same as GMP_ROOT=<prefix> and              #
#                                  BLAS_ROOT=<prefix>), $(BLAS_LIB) the name  #
#                                  of the CBLAS [see extlib/makefile-libBLAS] #
#                                                                             #
#   Output: $(ADSOBJ)            = the object of the module ads, if built     #
#           $(ADSH)              = the .h and .tpp files of ADS               #
#           $(ADSINC)            = all the -I$( include dirs ), -D and        #
#                                  compiler options of ADS                    #
#           $(ADSLIB)            = the external libraries + -L< libdirs >     #
#           $(ADSGMPON), $(ADSBLASON), $(ADSMPION) = 1 if the backend of      #
#                                  GMP, of the CBLAS, of MPI is on            #
#                                                                             #
###############################################################################

# OS-specific settings- - - - - - - - - - - - - - - - - - - - - - - - - - - -
# defines some general values, like UNAME_S, which identify the type of OS
# and UNAME_P which identify the architecture for which ADS is being
# compiled, so that other makefiles can rely on these to automatically adapt
# without a need for the user to manually edit them
include $(ADSSDR)/lib/makefile-OS

# default paths - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# include a makefile that defines all the *_ROOT paths needed by every other
# makefile (possibly after automatic OS adaptation, see above) relatively to
# the places where all external libraries are to be found; use the previously
# defined UNAME_S to load the one of the current OS
ifeq ($(UNAME_S),Linux)
    include $(ADSSDR)/extlib/makefile-default-paths-linux
endif
ifeq ($(UNAME_S),Darwin)
    include $(ADSSDR)/extlib/makefile-default-paths-macos
endif
ifeq ($(UNAME_S),Windows)
    include $(ADSSDR)/extlib/makefile-default-paths-win
endif

# non-default paths - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# optionally (note the "-" in front) include a makefile that defines all the
# *_ROOT paths needed by every other makefile to cater for external libraries
# being located in non-standard locations. This file is .gitignore-d, so that
# its values are not lost when pulling ADS anew or need be manually ignored
# when pushing changes
-include $(ADSSDR)/extlib/makefile-paths

# the prefixes of GMP and of the CBLAS given as GMP=<prefix> and
# BLAS=<prefix>, as the benchmarks take them
ifdef GMP
    GMP_ROOT = $(GMP)
endif
ifdef BLAS
    BLAS_ROOT = $(BLAS)
endif

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# each backend is included only if turned on, and it outputs some macros to
# be used here:
# *INC are the -I< include directories > and the options of the compiler
# *LIB are the external libraries + -L< libdirs >

ADSINC := $(ADSSWOS)
ADSLIB := -pthread

# GMP, for BigInteger and Rational, and a CBLAS, for gemm(): on where they
# are found unless turned off, auto by default
ADS_WITH_GMP ?= auto
ADS_WITH_BLAS ?= auto
ifneq ($(ADS_WITH_GMP),0)
    include $(ADSSDR)/extlib/makefile-libGMP
    ADSGMPON := $(strip $(if $(filter auto,$(ADS_WITH_GMP)),\
	$(libGMPFOUND),$(filter 1,$(ADS_WITH_GMP))))
endif
ifeq ($(ADSGMPON),1)
    ADSINC += -DADS_WITH_GMP $(libGMPINC)
    ADSLIB += $(libGMPLIB)
endif
ifneq ($(ADS_WITH_BLAS),0)
    include $(ADSSDR)/extlib/makefile-libBLAS
    ADSBLASON := $(strip $(if $(filter auto,$(ADS_WITH_BLAS)),\
	$(libBLASFOUND),$(filter 1,$(ADS_WITH_BLAS))))
endif
ifeq ($(ADSBLASON),1)
    ADSINC += -DADS_WITH_BLAS $(libBLASINC)
    ADSLIB += $(libBLASLIB)
endif

# OpenMP, for its executor
ifeq ($(ADS_WITH_OPENMP),1)
    include $(ADSSDR)/extlib/makefile-libOpenMP
    ADSINC += $(libOpenMPINC)
    ADSLIB += $(libOpenMPLIB)
endif

# oneTBB, for its executor
ifeq ($(ADS_WITH_TBB),1)
    include $(ADSSDR)/extlib/makefile-libTBB
    ADSINC += -DADS_WITH_TBB $(libTBBINC)
    ADSLIB += $(libTBBLIB)
endif

# FastFlow, for its executor
ifeq ($(ADS_WITH_FASTFLOW),1)
    include $(ADSSDR)/extlib/makefile-libFastFlow
    ADSINC += -DADS_WITH_FASTFLOW $(libFastFlowINC)
endif

# MPI, for the sort and the runtime over its processes: on where it is
# found unless turned off, auto by default
ADS_WITH_MPI ?= auto
ifneq ($(ADS_WITH_MPI),0)
    include $(ADSSDR)/extlib/makefile-libMPI
    ADSMPION := $(strip $(if $(filter auto,$(ADS_WITH_MPI)),\
	$(libMPIFOUND),$(filter 1,$(ADS_WITH_MPI))))
endif
ifeq ($(ADSMPION),1)
    ADSINC += -DADS_WITH_MPI $(libMPIINC)
    ADSLIB += $(libMPILIB)
endif

# include the ADS makefile requiring all external modules in input
include $(ADSSDR)/lib/makefile

############################## End of makefile-c ##############################
