 <tr><th>Function</th><th>Preparation</th><th>Search, worst case</th>
     <th>Remarks</th></tr>
 <tr><td><tt>naiveMatching()</tt></td><td>none</td>
     <td>\f$ O( n m ) \f$</td><td>\f$ O( n ) \f$ expected on random
     texts</td></tr>
 <tr><td><tt>kmp()</tt>, <tt>kmpStrong()</tt></td>
     <td>\f$ O( m ) \f$</td><td>at most \f$ 2 n \f$ comparisons</td>
     <td>reads \f$ T \f$ forward, never backs up</td></tr>
 <tr><td><tt>boyerMoore()</tt>, <tt>horspool()</tt></td>
     <td>\f$ O( m + \sigma ) \f$</td><td>\f$ O( n m ) \f$</td>
     <td>\f$ O( n / m ) \f$ comparisons at best</td></tr>
 <tr><td><tt>shiftOr()</tt></td><td>\f$ O( m + \sigma ) \f$</td>
