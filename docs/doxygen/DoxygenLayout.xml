      <variables visible="yes" title="Variables"/>
      <properties visible="yes" title=""/>
      <membergroups visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title="Detailed description"/>
    <memberdef>
      <inlineclasses visible="yes" title=""/>
      <typedefs visible="yes" title="Typedef documentation"/>
      <sequences visible="yes" title=""/>
      <dictionaries visible="yes" title=""/>
      <enums visible="yes" title="Enumeration type documentation"/>
      <functions visible="yes" title="Function documentation"/>
      <variables visible="yes" title="Variable documentation"/>
      <properties visible="yes" title=""/>
    </memberdef>
    <authorsection visible="yes"/>
  </namespace>

  <!-- Layout definition for a concept page -->
  <concept>
    <briefdescription visible="yes"/>
    <includes visible="$SHOW_HEADERFILE"/>
    <definition visible="yes" title=""/>
    <detaileddescription visible="yes" title="Detailed description"/>
    <authorsection visible="yes"/>
  </concept>

  <!-- Layout definition for a file page -->
  <file>
    <briefdescription visible="yes"/>
    <includes visible="$SHOW_INCLUDE_FILES"/>
    <includegraph visible="yes"/>
    <includedbygraph visible="yes"/>
    <sourcelink visible="yes"/>
    <memberdecl>
      <interfaces visible="yes" title=""/>
      <classes visible="yes" title="Classes"/>
      <structs visible="yes" title="Structs"/>
      <exceptions visible="yes" title=""/>
      <namespaces visible="yes" title="Namespaces"/>
      <concepts visible="yes" title="Concepts"/>
      <constantgroups visible="yes" title=""/>
      <defines visible="yes" title="Macros"/>
