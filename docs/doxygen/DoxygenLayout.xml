      <properties visible="yes" title=""/>
    </memberdef>
    <authorsection/>
  </file>

  <!-- Layout definition for a group page -->
  <group>
    <briefdescription visible="yes"/>
    <groupgraph visible="yes"/>
    <memberdecl>
      <nestedgroups visible="yes" title="Topics"/>
      <modules visible="yes" title=""/>
      <dirs visible="yes" title="Directories"/>
      <files visible="yes" title="Files"/>
      <namespaces visible="yes" title="Namespaces"/>
      <concepts visible="yes" title="Concepts"/>
      <classes visible="yes" title="Classes"/>
      <defines visible="yes" title="Macros"/>
      <typedefs visible="yes" title="Typedefs"/>
      <sequences visible="yes" title=""/>
      <dictionaries visible="yes" title=""/>
      <enums visible="yes" title="Enumerations"/>
      <enumvalues visible="yes" title=""/>
      <functions visible="yes" title="Functions"/>
      <variables visible="yes" title="Variables"/>
      <signals visible="yes" title=""/>
