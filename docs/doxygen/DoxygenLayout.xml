      <events visible="yes" title=""/>
      <properties visible="yes" title=""/>
      <friends visible="yes" title=""/>
      <membergroups visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title="Detailed description"/>
    <memberdef>
      <pagedocs/>
      <inlineclasses visible="yes" title=""/>
      <defines visible="yes" title="Macro definition documentation"/>
      <typedefs visible="yes" title="Typedef documentation"/>
      <sequences visible="yes" title=""/>
      <dictionaries visible="yes" title=""/>
      <enums visible="yes" title="Enumeration type documentation"/>
      <enumvalues visible="yes" title=""/>
