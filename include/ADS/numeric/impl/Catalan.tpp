/*-------------------------- IMPLEMENTATION --------------------------------*/
/*--------------------------------------------------------------------------*/

namespace ADS {

template< class T >
T catalan( int n )
{
 ADS_PRE( n >= 0 );
 std::vector< T > C( std::size_t( n ) + 1 , T( 0 ) );
 C[ 0 ] = T( 1 );
 for( int i = 1 ; i <= n ; ++i )
  for( int k = 0 ; k < i ; ++k )
   C[ i ] += C[ k ] * C[ i - 1 - k ];
 return( C[ n ] );
 }

/*--------------------------------------------------------------------------*/

}  // end( namespace ADS )

