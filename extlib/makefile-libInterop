###############################################################################
############################# makefile-libInterop #############################
###############################################################################
#                                                                             #
#   makefile of the runtimes of a program, for the executors on them [see     #
#   include/ADS/interop/parallel]: the parallel algorithms of the standard    #
#   library (on oneTBB with libstdc++), the senders of stdexec and Taskflow,  #
#   the last two by their headers; Kokkos is taken by CMake alone, since its  #
#   flags are those of its build                                              #
#                                                                             #
#   Input:  $(STDEXEC_ROOT)  = the directory of the sources of stdexec, whose #
#                              include/ has the headers, empty if they are    #
#                              where the compiler looks                       #
#           $(cereal_ROOT)   = the directory of the sources of cereal, whose  #
#                              include/ has the headers, empty if they are    #
#                              where the compiler looks                       #
#           $(Taskflow_ROOT) = the directory of the sources of Taskflow,      #
#                              which has taskflow/, empty if it is where the  #
#                              compiler looks                                 #
#           $(TBB_ROOT)      = the prefix of oneTBB [see makefile-libTBB]     #
#                                                                             #
#   Output: accordingly, there is no *H and *OBJ in output, since there is    #
#           no need to check for changes in the .h and rebuild the .o / .a    #
#                                                                             #
#           $(libStdParINC), $(libStdParLIB), $(libStdParFOUND)               #
#           $(libStdexecINC), $(libStdexecLIB), $(libStdexecFOUND)            #
#           $(libTaskflowINC), $(libTaskflowLIB), $(libTaskflowFOUND)         #
#           $(libCerealINC), $(libCerealLIB), $(libCerealFOUND)               #
#                            = the -I$(include directories) and the macro of  #
#                              the header, the libraries, and 1 if a program  #
#                              that uses the runtime compiles and links with  #
#                              them, empty otherwise (evaluated once, when    #
#                              first used)                                    #
#                                                                             #
###############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

libStdexecBSCDIR = $(subst $\",,$(STDEXEC_ROOT))
libTaskflowBSCDIR = $(subst $\",,$(Taskflow_ROOT))
libCerealBSCDIR = $(subst $\",,$(cereal_ROOT))
include $(ADSSDR)/extlib/makefile-libTBB

# a program of the parallel algorithms of the standard library
libStdParSRC = $(ADShash)include <algorithm>\n$(ADShash)include \
	<execution>\n$(ADShash)include <vector>\nint main(){std::vector<int> \
	v(100,1);std::for_each(std::execution::par,v.begin(),v.end(),\
	[](int&x){x++;});return v[0]-2;}\n

# a program of stdexec and one of Taskflow
libStdexecSRC = $(ADShash)include <stdexec/execution.hpp>\n$(ADShash)include \
	<exec/static_thread_pool.hpp>\nint main(){exec::static_thread_pool \
	p(1);stdexec::sync_wait(stdexec::schedule(p.get_scheduler()));}\n
libTaskflowSRC = $(ADShash)include <taskflow/taskflow.hpp>\n$(ADShash)include \
	<taskflow/algorithm/for_each.hpp>\nint main(){tf::Executor e(1);\
	tf::Taskflow f;f.for_each_index(0,2,1,[](int){});e.run(f).wait();}\n

# a program of cereal [see include/ADS/interop/cereal]
libCerealSRC = $(ADShash)include <cereal/archives/binary.hpp>\n$(ADShash)include \
	<sstream>\nint main(){std::stringstream s;cereal::BinaryOutputArchive \
	a(s);a(1);}\n

# the libraries with which the program $(1) links, given the flags $(2):
# none, or oneTBB (which the headers of <execution> of libstdc++ may ask
# for), or the word none if it does not link
libInteropLINK = $(shell \
	if printf '$(1)' | $(CXX) -std=c++20 -x c++ - $(2) -o /dev/null \
	   -pthread 2>/dev/null; then echo; \
	elif printf '$(1)' | $(CXX) -std=c++20 -x c++ - $(2) $(libTBBINC) \
	   -o /dev/null $(libTBBLIB) -pthread 2>/dev/null; then \
	echo '$(libTBBINC) $(libTBBLIB)'; else echo none; fi)

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# each library found once, when first used
libStdParINC = -DADS_WITH_STDPAR
libStdParLIB = $(eval libStdParLIB := $$(call libInteropLINK,\
	$$(libStdParSRC),))$(libStdParLIB)
libStdParFOUND = $(if $(filter none,$(libStdParLIB)),,1)

libStdexecINC = -DADS_WITH_STDEXEC $(if $(libStdexecBSCDIR),\
	-isystem "$(libStdexecBSCDIR)/include")
libStdexecLIB = $(eval libStdexecLIB := $$(call libInteropLINK,\
	$$(libStdexecSRC),$$(libStdexecINC)))$(libStdexecLIB)
libStdexecFOUND = $(if $(filter none,$(libStdexecLIB)),,1)

libTaskflowINC = -DADS_WITH_TASKFLOW $(if $(libTaskflowBSCDIR),\
	-isystem "$(libTaskflowBSCDIR)")
libTaskflowLIB = $(eval libTaskflowLIB := $$(call libInteropLINK,\
	$$(libTaskflowSRC),$$(libTaskflowINC)))$(libTaskflowLIB)
libTaskflowFOUND = $(if $(filter none,$(libTaskflowLIB)),,1)

libCerealINC = -DADS_WITH_CEREAL $(if $(libCerealBSCDIR),\
	-isystem "$(libCerealBSCDIR)/include")
libCerealLIB = $(eval libCerealLIB := $$(call libInteropLINK,\
	$$(libCerealSRC),$$(libCerealINC)))$(libCerealLIB)
libCerealFOUND = $(if $(filter none,$(libCerealLIB)),,1)

######################### End of makefile-libInterop ##########################
