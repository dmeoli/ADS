###############################################################################
############################# makefile-libInterop #############################
###############################################################################
#                                                                             #
#   makefile of the runtimes of a program, for the executors on them [see     #
#   include/ADS/interop/parallel]: the parallel algorithms of the standard    #
#   library (on oneTBB with libstdc++), the senders of stdexec and Taskflow,  #
#   the last two by their headers; Kokkos is taken by CMake alone, since its  #
#   flags are those of its build; and of the other libraries of the adapters  #
#   of include/ADS/interop: cereal, CRoaring, sdsl-lite 3 and nanoarrow, and  #
#   those of the graphs and of the matrices, Eigen, METIS, KaHIP,             #
#   SuiteSparse:GraphBLAS and NetworKit                                       #
#                                                                             #
#   Input:  $(STDEXEC_ROOT)  = the directory of the sources of stdexec, whose #
#                              include/ has the headers, empty if they are    #
#                              where the compiler looks                       #
#           $(cereal_ROOT)   = the directory of the sources of cereal, whose  #
#                              include/ has the headers, empty if they are    #
#                              where the compiler looks                       #
#           $(CRoaring_ROOT) = the prefix of CRoaring, whose include/ has the #
#                              headers and lib/ the library, empty if they    #
#                              are where the compiler and the linker look     #
#           $(sdsl_ROOT)     = the directory of the sources of sdsl-lite 3,   #
#                              whose include/ has the headers, empty if they  #
#                              are where the compiler looks                   #
#           $(Taskflow_ROOT) = the directory of the sources of Taskflow,      #
#                              which has taskflow/, empty if it is where the  #
#                              compiler looks                                 #
#           $(nanoarrow_ROOT), $(METIS_ROOT), $(KaHIP_ROOT),                  #
#           $(GraphBLAS_ROOT), $(NetworKit_ROOT), $(tlx_ROOT)                 #
#                            = the prefixes of nanoarrow, METIS, KaHIP,       #
#                              GraphBLAS (whose header may be in              #
#                              include/suitesparse), NetworKit and tlx, the   #
#                              same as $(CRoaring_ROOT)                       #
#           $(Eigen_ROOT)    = the prefix of Eigen, whose include/eigen3 has  #
#                              the headers, empty if Eigen/ is where the      #
#                              compiler looks                                 #
#           $(TBB_ROOT)      = the prefix of oneTBB [see makefile-libTBB]     #
#           $(OpenMP_ROOT)   = the prefix of libomp, for NetworKit [see       #
#                              makefile-libOpenMP]                            #
#                                                                             #
#   Output: accordingly, there is no *H and *OBJ in output, since there is    #
#           no need to check for changes in the .h and rebuild the .o / .a    #
#                                                                             #
#           $(libStdParINC), $(libStdParLIB), $(libStdParFOUND)               #
#           $(libStdexecINC), $(libStdexecLIB), $(libStdexecFOUND)            #
#           $(libTaskflowINC), $(libTaskflowLIB), $(libTaskflowFOUND)         #
#           $(libCerealINC), $(libCerealLIB), $(libCerealFOUND)               #
#           $(libCRoaringINC), $(libCRoaringLIB), $(libCRoaringFOUND)         #
#           $(libSdslINC), $(libSdslLIB), $(libSdslFOUND)                     #
#           $(libNanoarrowINC), $(libNanoarrowLIB), $(libNanoarrowFOUND)      #
#           $(libEigenINC), $(libEigenLIB), $(libEigenFOUND)                  #
#           $(libMetisINC), $(libMetisLIB), $(libMetisFOUND)                  #
#           $(libKaHIPINC), $(libKaHIPLIB), $(libKaHIPFOUND)                  #
#           $(libGraphBLASINC), $(libGraphBLASLIB), $(libGraphBLASFOUND)      #
#           $(libNetworKitINC), $(libNetworKitLIB), $(libNetworKitFOUND)      #
#                            = the -I$(include directories) and the macro of  #
#                              the header, the libraries, and 1 if a program  #
#                              that uses the runtime compiles and links with  #
#                              them, empty otherwise (evaluated once, when    #
#                              first used)                                    #
#                                                                             #
###############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

libStdexecBSCDIR = $(subst $\",,$(STDEXEC_ROOT))
libTaskflowBSCDIR = $(subst $\",,$(Taskflow_ROOT))
libCerealBSCDIR = $(subst $\",,$(cereal_ROOT))
libCRoaringBSCDIR = $(subst $\",,$(CRoaring_ROOT))
libSdslBSCDIR = $(subst $\",,$(sdsl_ROOT))
libNanoarrowBSCDIR = $(subst $\",,$(nanoarrow_ROOT))
libEigenBSCDIR = $(subst $\",,$(Eigen_ROOT))
libMetisBSCDIR = $(subst $\",,$(METIS_ROOT))
libKaHIPBSCDIR = $(subst $\",,$(KaHIP_ROOT))
libGraphBLASBSCDIR = $(subst $\",,$(GraphBLAS_ROOT))
libNetworKitBSCDIR = $(subst $\",,$(NetworKit_ROOT))
libTlxBSCDIR = $(subst $\",,$(tlx_ROOT))
include $(ADSSDR)/extlib/makefile-libTBB
include $(ADSSDR)/extlib/makefile-libOpenMP

# a program of the parallel algorithms of the standard library
libStdParSRC = $(ADShash)include <algorithm>\n$(ADShash)include \
	<execution>\n$(ADShash)include <vector>\nint main(){std::vector<int> \
	v(100,1);std::for_each(std::execution::par,v.begin(),v.end(),\
	[](int&x){x++;});return v[0]-2;}\n

# a program of stdexec and one of Taskflow
libStdexecSRC = $(ADShash)include <stdexec/execution.hpp>\n$(ADShash)include \
	<exec/static_thread_pool.hpp>\nint main(){exec::static_thread_pool \
	p(1);stdexec::sync_wait(stdexec::schedule(p.get_scheduler()));}\n
libTaskflowSRC = $(ADShash)include <taskflow/taskflow.hpp>\n$(ADShash)include \
	<taskflow/algorithm/for_each.hpp>\nint main(){tf::Executor e(1);\
	tf::Taskflow f;f.for_each_index(0,2,1,[](int){});e.run(f).wait();}\n

# a program of cereal [see include/ADS/interop/cereal]
libCerealSRC = $(ADShash)include <cereal/archives/binary.hpp>\n\
	$(ADShash)include <sstream>\nint main(){std::stringstream s;\
	cereal::BinaryOutputArchive a(s);a(1);}\n

# a program of CRoaring and one of sdsl-lite 3 (sdsl/cereal.hpp is of the
# version 3 alone) [see include/ADS/interop/croaring and
# include/ADS/interop/sdsl]
libCRoaringSRC = $(ADShash)include <roaring/roaring.h>\nint main(){\
	roaring_bitmap_t*r=roaring_bitmap_create();roaring_bitmap_free(r);}\n
libSdslSRC = $(ADShash)include <sdsl/cereal.hpp>\n$(ADShash)include \
	<sdsl/int_vector.hpp>\nint main(){sdsl::bit_vector b(9,0);\
	return int(b[3]);}\n

# a program of nanoarrow, which reads a column [see
# test/interop_columnar.cpp]
libNanoarrowSRC = $(ADShash)include <nanoarrow/nanoarrow.h>\nint main(){\
	struct ArrowSchema s;ArrowSchemaInit(&s);int r=ArrowSchemaSetType(&s,\
	NANOARROW_TYPE_INT64);s.release(&s);return r;}\n

# a program of each library of the graphs and of the matrices, the same as
# those of cmake/ADSInterop.cmake: Eigen 3.4 or later, METIS 5, KaHIP with
# the indices of its header, GraphBLAS 10 or later (in include/suitesparse
# or not) and NetworKit 11.2 or later, with fromCSR()
libEigenSRC = $(ADShash)include <Eigen/SparseCore>\nstatic_assert(\
	EIGEN_VERSION_AT_LEAST(3,4,0));\nint main(){Eigen::SparseMatrix<double,\
	Eigen::RowMajor,int> A(2,2);A.insert(1,0)=2.;return int(A.sum())-2;}\n
libMetisSRC = $(ADShash)include <metis.h>\nint main(){idx_t \
	o[METIS_NOPTIONS];return METIS_SetDefaultOptions(o)==METIS_OK?0:1;}\n
libKaHIPSRC = $(ADShash)include <kaHIP_interface.h>\nint main(){\
	return kahip_sizeof_idx()==int(sizeof(kahip_idx))?0:1;}\n
libGraphBLASSRC = $(ADShash)if __has_include(<suitesparse/GraphBLAS.h>)\n\
	$(ADShash)include <suitesparse/GraphBLAS.h>\n$(ADShash)else\n\
	$(ADShash)include <GraphBLAS.h>\n$(ADShash)endif\nstatic_assert(\
	GxB_IMPLEMENTATION_MAJOR>=10);\nint main(){GrB_Info(*f)(GxB_Container*)\
	=&GxB_Container_new;return f==nullptr?1:0;}\n
libNetworKitSRC = $(ADShash)include <networkit/graph/Graph.hpp>\n\
	$(ADShash)include <vector>\nint main(){std::vector<NetworKit::index> \
	p{0,1,1},i{1};std::vector<double> x;const NetworKit::Graph G=\
	NetworKit::Graph::fromCSR(p,i,x,false,false);\
	return int(G.numberOfEdges())-1;}\n

# the libraries with which the program $(1) links, given the flags $(2):
# none, or oneTBB (which the headers of <execution> of libstdc++ may ask
# for), or the word none if it does not link
libInteropLINK = $(shell \
	if printf '$(1)' | $(CXX) -std=c++20 -x c++ - $(2) -o $(ADSTRY) \
	   -pthread 2>/dev/null; then echo; \
	elif printf '$(1)' | $(CXX) -std=c++20 -x c++ - $(2) $(libTBBINC) \
	   -o $(ADSTRY) $(libTBBLIB) -pthread 2>/dev/null; then \
	echo '$(libTBBINC) $(libTBBLIB)'; else echo none; fi)

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# each library found once, when first used
libStdParINC = -DADS_WITH_STDPAR
libStdParLIB = $(eval libStdParLIB := $$(call libInteropLINK,\
	$$(libStdParSRC),))$(libStdParLIB)
libStdParFOUND = $(if $(filter none,$(libStdParLIB)),,1)

libStdexecINC = -DADS_WITH_STDEXEC $(if $(libStdexecBSCDIR),\
	-isystem "$(libStdexecBSCDIR)/include")
libStdexecLIB = $(eval libStdexecLIB := $$(call libInteropLINK,\
	$$(libStdexecSRC),$$(libStdexecINC)))$(libStdexecLIB)
libStdexecFOUND = $(if $(filter none,$(libStdexecLIB)),,1)

libTaskflowINC = -DADS_WITH_TASKFLOW $(if $(libTaskflowBSCDIR),\
	-isystem "$(libTaskflowBSCDIR)")
libTaskflowLIB = $(eval libTaskflowLIB := $$(call libInteropLINK,\
	$$(libTaskflowSRC),$$(libTaskflowINC)))$(libTaskflowLIB)
libTaskflowFOUND = $(if $(filter none,$(libTaskflowLIB)),,1)

libCerealINC = -DADS_WITH_CEREAL $(if $(libCerealBSCDIR),\
	-isystem "$(libCerealBSCDIR)/include")
libCerealLIB = $(eval libCerealLIB := $$(call libInteropLINK,\
	$$(libCerealSRC),$$(libCerealINC)))$(libCerealLIB)
libCerealFOUND = $(if $(filter none,$(libCerealLIB)),,1)

libInteropCOMMA := ,
libCRoaringLD = $(if $(libCRoaringBSCDIR),-L"$(libCRoaringBSCDIR)/lib" \
	-Wl$(libInteropCOMMA)-rpath$(libInteropCOMMA)"$(libCRoaringBSCDIR)/lib") \
	-lroaring
libCRoaringINC = -DADS_WITH_CROARING $(if $(libCRoaringBSCDIR),\
	-isystem "$(libCRoaringBSCDIR)/include")
libCRoaringLIB = $(eval libCRoaringLIB := $$(libCRoaringLD) $$(call \
	libInteropLINK,$$(libCRoaringSRC),$$(libCRoaringINC) \
	$$(libCRoaringLD)))$(libCRoaringLIB)
libCRoaringFOUND = $(if $(filter none,$(libCRoaringLIB)),,1)

libSdslINC = -DADS_WITH_SDSL $(if $(libSdslBSCDIR),\
	-isystem "$(libSdslBSCDIR)/include")
libSdslLIB = $(eval libSdslLIB := $$(call libInteropLINK,\
	$$(libSdslSRC),$$(libSdslINC)))$(libSdslLIB)
libSdslFOUND = $(if $(filter none,$(libSdslLIB)),,1)

# the flags of a library from its prefix $(1): its headers, and the
# directory of its library, also where the program looks for it when it runs
libInteropDIRINC = $(if $(strip $(1)),-isystem "$(strip $(1))/include")
libInteropDIRLD = $(if $(strip $(1)),-L"$(strip $(1))/lib" \
	-Wl$(libInteropCOMMA)-rpath$(libInteropCOMMA)"$(strip $(1))/lib")

# nanoarrow, by its static library, or else by its shared one (named
# nanoarrow before its version 0.7)
libNanoarrowINC = -DADS_WITH_NANOARROW $(call libInteropDIRINC,\
	$(libNanoarrowBSCDIR))
libNanoarrowTRY = $(if $(filter none,$(call libInteropLINK,\
	$(libNanoarrowSRC),$(libNanoarrowINC) $(call libInteropDIRLD,\
	$(libNanoarrowBSCDIR)) -l$(1))),none,$(call libInteropDIRLD,\
	$(libNanoarrowBSCDIR)) -l$(1))
libNanoarrowLIB = $(eval libNanoarrowLIB := $$(or $$(filter-out none,\
	$$(call libNanoarrowTRY,nanoarrow_static)),$$(filter-out none,\
	$$(call libNanoarrowTRY,nanoarrow_shared)),$$(call libNanoarrowTRY,\
	nanoarrow)))$(libNanoarrowLIB)
libNanoarrowFOUND = $(if $(filter none,$(libNanoarrowLIB)),,1)

libEigenINC = -DADS_WITH_EIGEN $(if $(libEigenBSCDIR),\
	-isystem "$(libEigenBSCDIR)/include/eigen3")
libEigenLIB = $(eval libEigenLIB := $$(call libInteropLINK,\
	$$(libEigenSRC),$$(libEigenINC)))$(libEigenLIB)
libEigenFOUND = $(if $(filter none,$(libEigenLIB)),,1)

libMetisINC = -DADS_WITH_METIS $(call libInteropDIRINC,$(libMetisBSCDIR))
libMetisLD = $(call libInteropDIRLD,$(libMetisBSCDIR)) -lmetis
libMetisLIB = $(eval libMetisLIB := $$(libMetisLD) $$(call \
	libInteropLINK,$$(libMetisSRC),$$(libMetisINC) \
	$$(libMetisLD)))$(libMetisLIB)
libMetisFOUND = $(if $(filter none,$(libMetisLIB)),,1)

libKaHIPINC = -DADS_WITH_KAHIP $(call libInteropDIRINC,$(libKaHIPBSCDIR))
libKaHIPLD = $(call libInteropDIRLD,$(libKaHIPBSCDIR)) -lkahip
libKaHIPLIB = $(eval libKaHIPLIB := $$(libKaHIPLD) $$(call \
	libInteropLINK,$$(libKaHIPSRC),$$(libKaHIPINC) \
	$$(libKaHIPLD)))$(libKaHIPLIB)
libKaHIPFOUND = $(if $(filter none,$(libKaHIPLIB)),,1)

libGraphBLASINC = -DADS_WITH_GRAPHBLAS $(call libInteropDIRINC,\
	$(libGraphBLASBSCDIR))
libGraphBLASLD = $(call libInteropDIRLD,$(libGraphBLASBSCDIR)) -lgraphblas
libGraphBLASLIB = $(eval libGraphBLASLIB := $$(libGraphBLASLD) $$(call \
	libInteropLINK,$$(libGraphBLASSRC),$$(libGraphBLASINC) \
	$$(libGraphBLASLD)))$(libGraphBLASLIB)
libGraphBLASFOUND = $(if $(filter none,$(libGraphBLASLIB)),,1)

# NetworKit with the headers of tlx and OpenMP, which its headers use
libNetworKitINC = -DADS_WITH_NETWORKIT $(call libInteropDIRINC,\
	$(libNetworKitBSCDIR)) $(call libInteropDIRINC,$(libTlxBSCDIR)) \
	$(libOpenMPINC)
libNetworKitLD = $(call libInteropDIRLD,$(libNetworKitBSCDIR)) -lnetworkit \
	$(libOpenMPLIB)
libNetworKitLIB = $(eval libNetworKitLIB := $$(libNetworKitLD) $$(call \
	libInteropLINK,$$(libNetworKitSRC),$$(libNetworKitINC) \
	$$(libNetworKitLD)))$(libNetworKitLIB)
libNetworKitFOUND = $(if $(filter none,$(libNetworKitLIB)),,1)

######################### End of makefile-libInterop ##########################
