###############################################################################
############################# makefile-libOpenMP ##############################
###############################################################################
#                                                                             #
#   makefile of OpenMP, for its executor [see OpenMPExecutor.h]               #
#                                                                             #
#   Input:  $(OpenMP_ROOT) = the prefix of libomp, for a compiler whose       #
#                           driver does not have it (the clang++ of macOS)    #
#                                                                             #
#   Output: accordingly, there is no *H and *OBJ in output, since there is    #
#           no need to check for changes in the .h and rebuild the .o / .a    #
#                                                                             #
#           $(libOpenMPINC) = the options of the compiler for OpenMP          #
#           $(libOpenMPLIB) = the options of the linker for OpenMP            #
#                                                                             #
###############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic libomp directory without quotes, if any
libOpenMPBSCDIR = $(subst $\",,$(OpenMP_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -
# whether $(CXX) builds a program with -fopenmp, asked once; a compiler that
# does not (the clang++ of macOS) takes it only through its preprocessor,
# and libomp from Homebrew

libOpenMPNATIVE = $(eval libOpenMPNATIVE := $$(shell echo 'int main(){}' \
	| $$(CXX) -fopenmp -x c++ - -o $$(ADSNULL) >$$(ADSNULL) 2>&1 \
	&& echo 1))$(libOpenMPNATIVE)
libOpenMPINC = $(if $(libOpenMPNATIVE),-fopenmp,\
	-Xpreprocessor -fopenmp -I"$(libOpenMPBSCDIR)/include")
libOpenMPLIB = $(if $(libOpenMPNATIVE),-fopenmp,\
	-L"$(libOpenMPBSCDIR)/lib" -lomp)

########################## End of makefile-libOpenMP ##########################
