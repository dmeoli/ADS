###############################################################################
############################## makefile-libLEMON ##############################
###############################################################################
#                                                                             #
#   makefile of abLEMON, for the interoperation of include/ADS/interop/lemon  #
#   and for the solves that ADS delegates to it [see Matching.h and           #
#   Assignment.h]                                                             #
#                                                                             #
#   Input:  $(LEMON_ROOT) = the prefix where abLEMON is installed, empty if   #
#                           it is where the compiler looks                    #
#                                                                             #
#   Output: accordingly, there is no *H and *OBJ in output, since there is    #
#           no need to check for changes in the .h and rebuild the .o / .a    #
#                                                                             #
#           $(libLEMONINC)   = the -I$(include directories) for abLEMON, and  #
#                              -DLEMON_ONLY_TEMPLATES, so that nothing of     #
#                              abLEMON is linked                              #
#           $(libLEMONLIB)   = nothing, the headers alone are used            #
#           $(libLEMONFOUND) = 1 if a program with a map of arcs of a         #
#                              ListDigraph and Dijkstra's algorithm compiles  #
#                              in C++20 with them (abLEMON does, LEMON 1.3    #
#                              does not), empty otherwise (evaluated once,    #
#                              when first used)                               #
#                                                                             #
###############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic abLEMON directory without quotes, if any
libLEMONBSCDIR = $(subst $\",,$(LEMON_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libLEMONINC = $(if $(libLEMONBSCDIR),-I"$(libLEMONBSCDIR)/include") \
	      -DLEMON_ONLY_TEMPLATES
libLEMONLIB =

# a program with a map of arcs, a map of nodes to arcs and Dijkstra's
# algorithm, compiled once in C++20
libLEMONFOUND = $(eval libLEMONFOUND := $$(shell printf '$$(ADShash)include \
	<lemon/dijkstra.h>\n$$(ADShash)include <lemon/list_graph.h>\n\
	int main(){lemon::ListDigraph g;lemon::ListDigraph::ArcMap<int> l(g);\
	lemon::ListDigraph::NodeMap<lemon::ListDigraph::Arc> p(g);\
	lemon::ListDigraph::Node s=g.addNode();l[g.addArc(s,g.addNode())]=1;\
	lemon::Dijkstra<lemon::ListDigraph> d(g,l);d.run(s);\
	return d.reached(s)?0:1;}\n' | \
	$$(CXX) -std=c++20 -x c++ -fsyntax-only - $$(libLEMONINC) \
	2>/dev/null && echo 1))$(libLEMONFOUND)

########################## End of makefile-libLEMON ###########################
