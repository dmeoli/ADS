###############################################################################
############################### makefile-libGMP ###############################
###############################################################################
#                                                                             #
#   makefile of libGMP, for BigInteger [see BigInteger.h]                     #
#                                                                             #
#   Input:  $(GMP_ROOT) = the prefix where GMP is installed, empty if         #
#                         it is where the compiler looks                      #
#           $(UNAME_S)  = the name of the current OS [see makefile-OS]        #
#                                                                             #
#   Output: accordingly, there is no *H and *OBJ in output, since there is    #
#           no need to check for changes in the .h and rebuild the .o / .a    #
#                                                                             #
#           $(libGMPINC)   = the -I$(include directories) for GMP             #
#           $(libGMPLIB)   = external libraries + -L< libdirs > for GMP       #
#           $(libGMPFOUND) = 1 if a program that calls the functions of GMP   #
#                            6 that the backends use compiles and links with  #
#                            them, empty otherwise (evaluated once, when      #
#                            first used)                                      #
#                                                                             #
###############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic GMP directory without quotes, if any
libGMPBSCDIR = $(subst $\",,$(GMP_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libGMPINC = $(if $(libGMPBSCDIR),-I"$(libGMPBSCDIR)/include")
libGMPLIB = $(if $(libGMPBSCDIR),-L"$(libGMPBSCDIR)/lib" \
	$(if $(filter Windows,$(UNAME_S)),,\
		-Wl$(ADScomma)-rpath$(ADScomma)"$(libGMPBSCDIR)/lib")) -lgmp

# a program with mpz_roinit_n() and mpn_sqrtrem(), compiled and linked once
libGMPFOUND = $(eval libGMPFOUND := $$(shell printf '$$(ADShash)include \
	<gmp.h>\nint main(){mp_limb_t a[1]={4},s[1];mpz_t x;\
	mpz_roinit_n(x,a,1);mpn_sqrtrem(s,0,a,1);return int(s[0])-2;}\n' | \
	$$(CXX) -x c++ - -o $$(ADSNULL) $$(libGMPINC) $$(libGMPLIB) \
	2>/dev/null && echo 1))$(libGMPFOUND)

########################### End of makefile-libGMP ############################
